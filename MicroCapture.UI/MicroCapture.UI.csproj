<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <None Update="tessdata\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="..\lib\EDSDK\Windows\EDSDK_64\Dll\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Local macOS dev/test convenience only: OpenCvSharp4.runtime.osx_arm64's native
       library resolves its own dependencies (libfreetype, libharfbuzz, etc.) via
       "@executable_path/../libs", which doesn't match `dotnet build`'s output layout.
       Mirror the native folder there so Cv2 calls actually work when testing on Mac.
       No effect on Windows builds/publishes. -->
  <Target Name="FixOpenCvMacOsLibraryPath" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ItemGroup>
      <OpenCvMacNativeDeps Include="$(OutDir)runtimes/osx-arm64/native/*.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(OpenCvMacNativeDeps)" DestinationFolder="$(OutDir)..\libs" SkipUnchangedFiles="true" Condition="'@(OpenCvMacNativeDeps)' != ''" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.1.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MicroCapture.Core\MicroCapture.Core.csproj" />
    <ProjectReference Include="..\MicroCapture.Camera\MicroCapture.Camera.csproj" />
    <ProjectReference Include="..\MicroCapture.Processing\MicroCapture.Processing.csproj" />
  </ItemGroup>
</Project>
