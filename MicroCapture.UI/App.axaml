<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MicroCapture.UI.App"
             xmlns:local="using:MicroCapture.UI"
             RequestedThemeVariant="Dark">
             <!-- Dark remains the default and the design centre — this is a professional imaging
                  tool, and every comparable one (Lightroom, Capture One, ABBYY FineReader) leads
                  with a dark canvas so the operator judges an image against a neutral ground
                  rather than a glowing one.
                  The variant is still declared here rather than left at "Default" so that the
                  built-in Fluent chrome (CheckBox, Slider, ScrollBar) has a definite variant
                  before any preference is read, and so the designer preview has one. AppTheme
                  overwrites it at startup with the operator's saved choice — including
                  "System", which is the only setting that lets the OS decide. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://MicroCapture.UI/Styles/Theme.axaml"/>
    </Application.Styles>
</Application>