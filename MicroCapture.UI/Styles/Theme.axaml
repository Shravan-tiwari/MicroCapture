<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Shared design tokens, adapted from the Linear-philosophy reference document: a near-black
    canvas + surface ladder, one restrained accent, and hairline borders — extended with a
    semantic status set (success/warning/fail) the reference document didn't need for a
    marketing page but this app cannot ship without. See the UI audit artifact for the full
    rationale. Styling only — no control here changes what data flows, only how it renders.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Surface ladder -->
      <SolidColorBrush x:Key="CanvasBrush" Color="#010102"/>
      <SolidColorBrush x:Key="Surface1Brush" Color="#0f1011"/>
      <SolidColorBrush x:Key="Surface2Brush" Color="#141516"/>
      <SolidColorBrush x:Key="Surface3Brush" Color="#1a1b1d"/>

      <!-- Text -->
      <SolidColorBrush x:Key="InkBrush" Color="#f7f8f8"/>
      <SolidColorBrush x:Key="InkMutedBrush" Color="#c9cdd6"/>
      <SolidColorBrush x:Key="InkSubtleBrush" Color="#8a8f98"/>
      <SolidColorBrush x:Key="InkTertiaryBrush" Color="#62666d"/>

      <!-- Hairlines -->
      <SolidColorBrush x:Key="HairlineBrush" Color="#23252a"/>
      <SolidColorBrush x:Key="HairlineStrongBrush" Color="#34343a"/>

      <!-- Accent — reserved for exactly one primary action per screen, focus rings, and the
           brand-adjacent numeric readouts (page count). Never used decoratively. -->
      <SolidColorBrush x:Key="PrimaryBrush" Color="#5e6ad2"/>
      <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#828fff"/>
      <SolidColorBrush x:Key="PrimaryFocusBrush" Color="#5e69d1"/>
      <SolidColorBrush x:Key="PrimaryWashBrush" Color="#1f2266d2"/>

      <!-- Semantic status — separate from the accent on purpose, so it always means the same
           thing wherever it appears. -->
      <SolidColorBrush x:Key="SuccessBrush" Color="#27a644"/>
      <SolidColorBrush x:Key="WarningBrush" Color="#d99a3d"/>
      <SolidColorBrush x:Key="FailBrush" Color="#e5484d"/>

      <!-- Type scale -->
      <x:Double x:Key="FontSizeDisplay">24</x:Double>
      <x:Double x:Key="FontSizeBody">14</x:Double>
      <x:Double x:Key="FontSizeCaption">12</x:Double>
      <x:Double x:Key="FontSizeLabel">11.5</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ───────────── Buttons ───────────── -->

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
  </Style>
  <Style Selector="Button.primary:pressed">
    <Setter Property="Background" Value="{StaticResource PrimaryFocusBrush}"/>
  </Style>

  <!-- The one button that visually signals "this is currently on" — Auto Capture, toggled
       via the IsAutoCapture-bound Classes.active on the Button in MainWindow.axaml. -->
  <Style Selector="Button.toggle">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.toggle.active">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Button.toggle:pointerover">
    <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
  </Style>
  <Style Selector="Button.toggle.active:pointerover">
    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.secondary:pointerover">
    <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  </Style>

  <Style Selector="Button.accentGhost">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryHoverBrush}"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <Style Selector="Button.destructive">
    <Setter Property="Background" Value="{StaticResource FailBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <!-- Small circular icon button — delete affordance on a thumbnail tile. Hidden until the
       tile is hovered so it doesn't compete with "click to review" at rest. -->
  <Style Selector="Button.iconDanger">
    <Setter Property="Background" Value="{StaticResource FailBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="99"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Grid.thumb:pointerover Button.iconDanger">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- ───────────── Cart tile actions ─────────────
       Select and delete used to be two 20px circles pinned outside the tile on negative margins,
       overlapping the neighbouring tile and easy to hit by mistake. They now sit inside the tile
       in a strip that fades in on hover, with real hit targets. The strip stays visible while a
       page is selected, so the selection is legible without hovering every tile to find it. -->
  <Style Selector="Grid.tileActions">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Grid.thumb:pointerover Grid.tileActions">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="Button.tileAction">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  </Style>
  <Style Selector="Button.tileAction:pointerover">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
  </Style>
  <Style Selector="Button.tileAction.danger:pointerover">
    <Setter Property="Background" Value="{StaticResource FailBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource FailBrush}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <!-- A selected page keeps its controls on screen rather than hiding them again on mouse-out. -->
  <Style Selector="Grid.thumb Button.tile">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <!-- Every button gets a visible focus ring for keyboard-first operation — the app leans on
       Space/R/A shortcuts already, but nothing previously showed which control had focus. -->
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>

  <!-- ───────────── Cards / panels ───────────── -->

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <!-- ───────────── Typography ───────────── -->

  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="Foreground" Value="{StaticResource InkTertiaryBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="1"/>
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{StaticResource InkSubtleBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
  </Style>

</Styles>
