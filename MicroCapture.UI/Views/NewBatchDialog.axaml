<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MicroCapture.UI.ViewModels"
        x:Class="MicroCapture.UI.Views.NewBatchDialog"
        Title="New Batch"
        Icon="/Assets/microcapture-icon.png"
        Width="620" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Border Classes="panel" Margin="18" Padding="20">
        <Grid RowDefinitions="Auto, Auto, *, Auto, Auto">
            <TextBlock Grid.Row="0" Text="NEW BATCH" Classes="sectionLabel" Foreground="{DynamicResource PrimaryHoverBrush}" Margin="0,0,0,14"/>
            <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,0,16"
                       Text="These settings apply to every page in the batch and are fixed once it's created, so all its pages come out matching. They're saved into the batch folder, so the batch opens with the same settings on any machine."/>

            <ScrollViewer Grid.Row="2">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="6">
                        <TextBlock Text="PROJECT CODE" Classes="sectionLabel"/>
                        <!-- Suggests existing projects as you type (contains-match, case-insensitive).
                             Text two-way binds to ProjectCode, so picking a suggestion or typing a
                             new code both flow through the same property — and the VM's
                             known-project snap points the location at that project's folder. -->
                        <AutoCompleteBox Text="{Binding ProjectCode, Mode=TwoWay}"
                                         ItemsSource="{Binding KnownProjects}"
                                         ValueMemberBinding="{Binding Code}"
                                         FilterMode="Contains"
                                         MinimumPrefixLength="1"
                                         IsTextCompletionEnabled="False"
                                         Watermark="e.g. QLD-TOURISM"
                                         Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource InkBrush}"
                                         BorderBrush="{DynamicResource HairlineStrongBrush}" CornerRadius="8">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="1" Margin="2">
                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"/>
                                        <TextBlock Text="{Binding Location}" FontSize="11"
                                                   Foreground="{DynamicResource InkTertiaryBrush}" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="BATCH CODE" Classes="sectionLabel"/>
                        <TextBox Text="{Binding BatchCode}" Watermark="e.g. CAIRNS-001"
                                 Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource InkBrush}"
                                 BorderBrush="{DynamicResource HairlineStrongBrush}" CornerRadius="8"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="BATCH LOCATION ON DRIVE" Classes="sectionLabel"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding BatchLocation}" Watermark="Choose a folder…"
                                     Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource InkBrush}"
                                     BorderBrush="{DynamicResource HairlineStrongBrush}" CornerRadius="8"/>
                            <Button Grid.Column="1" Content="Browse…" Classes="secondary" Margin="8,0,0,0"
                                    Command="{Binding BrowseCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding ResolvedBatchFolder}" FontSize="11" Foreground="{DynamicResource InkTertiaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource InkTertiaryBrush}" TextWrapping="Wrap"
                                   Text="Saving to a shared drive lets other workstations open this batch. A local folder works too — the batch can still be copied or moved later and will open correctly."/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, *" Margin="0,4,0,0">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,7,0">
                            <TextBlock Text="DPI" Classes="sectionLabel"/>
                            <ComboBox ItemsSource="{Binding AvailableDpiOptions}" SelectedItem="{Binding SelectedDpi}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="150 is the rig's native captured size. Lower values downsample, higher values upsample.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}{0} DPI'}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" Margin="7,0,0,0">
                            <TextBlock Text="CAPTURE FORMAT" Classes="sectionLabel"/>
                            <ComboBox ItemsSource="{Binding AvailableCaptureFormats}" SelectedItem="{Binding SelectedCaptureFormat}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Format each captured page is written in. Binarized output is always TIFF regardless of this."/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="8" Margin="0,4,0,0">
                        <TextBlock Text="PROCESSING" Classes="sectionLabel"/>
                        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource InkTertiaryBrush}"
                                   Text="These are being built and can't be switched on yet. They're listed here so you can see what's coming."/>
                        <!-- Shown but not operable. Listing them communicates the roadmap; leaving
                             them clickable would let an operator set an option that silently does
                             nothing to their batch. -->
                        <StackPanel Spacing="8" IsEnabled="False" Opacity="0.55">
                            <CheckBox IsChecked="{Binding DewarpEnabled}" Content="Book curve correction  (in development)"
                                      Foreground="{DynamicResource InkMutedBrush}"/>
                            <CheckBox IsChecked="{Binding SplitBookPages}" Content="Split book pages  (in development)"
                                      Foreground="{DynamicResource InkMutedBrush}"/>
                            <CheckBox IsChecked="{Binding BinarizeEnabled}" Content="Binarize (black &amp; white)  (in development)"
                                      Foreground="{DynamicResource InkMutedBrush}"/>
                            <CheckBox IsChecked="{Binding BleedthroughEnabled}" Content="Bleedthrough suppression  (in development)"
                                      Foreground="{DynamicResource InkMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,9" Margin="0,14,0,0"
                    IsVisible="{Binding HasValidationMessage}">
                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource InkBrush}"/>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
                <Button Content="Cancel" Classes="secondary" Command="{Binding CancelCommand}"/>
                <Button Content="Create Batch" Classes="primary" Command="{Binding CreateCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
