<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MicroCapture.UI.ViewModels"
        x:Class="MicroCapture.UI.Views.FinalizeBatchDialog"
        Title="Finalize Batch"
        Icon="/Assets/microcapture-icon.png"
        Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Border Classes="panel" Margin="18" Padding="20">
        <Grid RowDefinitions="Auto, *, Auto, Auto" ColumnDefinitions="2*, 1*">

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="FINALIZE BATCH"
                       Classes="sectionLabel" Foreground="{StaticResource PrimaryHoverBrush}" Margin="0,0,0,14"/>

            <!-- Page list: reorder / delete -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface1Brush}" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border Grid.Column="0" Width="60" Height="60" CornerRadius="4" ClipToBounds="True"
                                                Background="{StaticResource Surface2Brush}" Margin="0,0,10,0">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{StaticResource InkBrush}"
                                                   Text="{Binding PageNumber, StringFormat='Page {0}'}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Content="↑" Width="28" Click="OnMoveUpClick" Classes="secondary"/>
                                            <Button Content="↓" Width="28" Click="OnMoveDownClick" Classes="secondary"/>
                                            <Button Content="✕" Width="28" Click="OnDeletePageClick" Classes="iconDanger"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Export options -->
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="14">
                <StackPanel Spacing="6">
                    <TextBlock Text="FORMAT" Classes="sectionLabel" FontSize="11" Foreground="{StaticResource InkTertiaryBrush}"/>
                    <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <CheckBox IsChecked="{Binding EmbedSearchableText}" Content="Searchable text (OCR)"
                          IsVisible="{Binding IsPdfFormat}"
                          ToolTip.Tip="Embeds a near-invisible OCR text layer so the PDF's text is selectable/searchable. Runs OCR on any page that doesn't have it yet, which can take a while for a large batch."
                          Foreground="{StaticResource InkMutedBrush}"/>

                <!-- OCR otherwise runs as part of the export, which on a large batch means a long
                     wait at the one moment the operator is trying to finish. This is the old
                     toolbar "Run OCR" action, kept here where OCR is actually decided: get it out
                     of the way first, then export quickly. -->
                <Button Content="Run OCR now" Classes="secondary" HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsPdfFormat}"
                        Command="{Binding RunOcrNowCommand}"
                        ToolTip.Tip="Run OCR on this batch's pages now, so the export itself doesn't have to wait for it"/>
                <TextBlock Text="{Binding OcrStatusText}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource InkTertiaryBrush}"
                           IsVisible="{Binding HasOcrStatus}"/>

                <StackPanel Spacing="6" IsVisible="{Binding SupportsWatermark}">
                    <CheckBox IsChecked="{Binding WatermarkEnabled}" Content="Watermark"
                              ToolTip.Tip="Burns the selected watermark preset into every exported page, whichever format you choose."
                              Foreground="{StaticResource InkMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding WatermarkEnabled}">
                        <ComboBox ItemsSource="{Binding WatermarkPresets}" SelectedItem="{Binding SelectedWatermarkPreset}" Width="160">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Edit Watermark…" Classes="secondary"
                                Command="{Binding EditWatermarkCommand}" CommandParameter="{Binding $parent[Window]}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="FILE NAME" Classes="sectionLabel" FontSize="11" Foreground="{StaticResource InkTertiaryBrush}"/>
                    <TextBox Text="{Binding FileName}" Background="{StaticResource Surface2Brush}"
                             Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" CornerRadius="8"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="DESTINATION" Classes="sectionLabel" FontSize="11" Foreground="{StaticResource InkTertiaryBrush}"/>
                    <TextBox Text="{Binding DestinationDirectory}" IsReadOnly="True" Background="{StaticResource Surface2Brush}"
                             Foreground="{StaticResource InkMutedBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" CornerRadius="8"/>
                    <Button Content="Browse…" Classes="secondary" HorizontalAlignment="Stretch"
                            Command="{Binding BrowseDestinationCommand}" CommandParameter="{Binding $parent[Window]}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0" Spacing="6">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource InkMutedBrush}"/>

                <!-- Shown only while an export is running. A large batch is minutes of solid work;
                     without this the dialog looked frozen and there was no way to tell a healthy
                     export from a hung one, or to stop one started by mistake. -->
                <StackPanel Spacing="6" IsVisible="{Binding IsExporting}">
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}"
                                 IsIndeterminate="{Binding ProgressIsIndeterminate}"
                                 Height="6" CornerRadius="3"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="12"
                                   Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" FontSize="12"
                                   Foreground="{StaticResource InkTertiaryBrush}"/>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource InkTertiaryBrush}" TextWrapping="Wrap"
                               Text="You can keep this window open — the batch isn't changed until the export finishes."/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0" Spacing="10">
                <!-- Stops the running export; the plain Cancel closes the dialog. Only one of the
                     two is ever offered, so the button that is showing always does what it says. -->
                <Button Content="Stop Export" Classes="secondary" Command="{Binding CancelExportCommand}"
                        IsVisible="{Binding IsExporting}"
                        ToolTip.Tip="Stops after the current page. Nothing is written and the batch is left unchanged."/>
                <Button Content="Cancel" Classes="secondary" Command="{Binding CancelCommand}"
                        IsVisible="{Binding !IsExporting}"/>
                <Button Content="Export" Classes="primary" Command="{Binding ExportCommand}"
                        IsVisible="{Binding !IsExporting}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
