<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MicroCapture.UI.ViewModels"
        xmlns:views="using:MicroCapture.UI.Views"
        xmlns:controls="using:MicroCapture.UI.Controls"
        xmlns:conv="using:MicroCapture.UI.Converters"
        xmlns:acv="using:Avalonia.Data.Converters"
        xmlns:core="using:MicroCapture.Core.Interfaces"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        x:Class="MicroCapture.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MicroCapture"
        Icon="/Assets/microcapture-icon.png"
        Width="1400" Height="800"
        MinWidth="960" MinHeight="640"
        Background="{DynamicResource CanvasBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Filmstrip row (3rd). This row has to hold three things, and was repeatedly sized for
         only some of them: the selection/undo action bar, a tile tall enough for its image plus
         the page-number and status lines, and the horizontal scrollbar underneath. At 140px the
         tile's lower rows were clipped away — which is why page numbers and status text appeared
         missing even though both were bound correctly. Sized for all three now; the inner
         ScrollViewer scrolls horizontally only, so anything that doesn't fit vertically is lost
         rather than reachable. -->
    <Grid RowDefinitions="Auto, *, 200, Auto">

        <!-- ═══════════════ TOP TOOLBAR ═══════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource Surface1Brush}" Padding="14,10"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <!-- Only the four buttons the workflow is built around live up here:
                     Connect/Disconnect, New Batch, Open Batch, Finalize Batch. Everything that
                     used to sit alongside them — project/batch codes, DPI, format, and the
                     processing toggles — now belongs to the New Batch dialog, where it is chosen
                     once for the whole batch instead of being adjustable mid-batch (which
                     produced batches whose pages didn't match each other). Run OCR moved into
                     Finalize, which already offers OCR as part of the export. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="toggle" Classes.active="{Binding IsConnected}"
                            Command="{Binding ConnectCommand}"
                            Content="{Binding ConnectionStatus}"
                            ToolTip.Tip="Connect or disconnect the camera"/>
                    <Button Classes="primary" Command="{Binding NewBatchCommand}"
                            CommandParameter="{Binding $parent[Window]}" Content="New Batch"
                            ToolTip.Tip="Create a batch — choose where it's saved, its DPI, format, and processing options"/>
                    <Button Classes="secondary" Command="{Binding OpenBatchCommand}"
                            CommandParameter="{Binding $parent[Window]}" Content="Open Batch"
                            ToolTip.Tip="Continue an existing batch, including one started on another workstation"/>
                    <Button Classes="primary" Command="{Binding OpenFinalizeBatchCommand}"
                            CommandParameter="{Binding $parent[Window]}" Content="Finalize Batch"
                            ToolTip.Tip="Review, reorder, and export this batch's pages — choose format, OCR, filename and destination"/>
                    <Button Classes="secondary" Command="{Binding CloseBatchCommand}"
                            CommandParameter="{Binding $parent[Window]}" Content="Close Batch"
                            IsVisible="{Binding HasOpenBatch}"
                            ToolTip.Tip="Put this batch down and return to an empty screen. Nothing is deleted — reopen it any time."/>
                </StackPanel>

                <!-- Current batch and page count. Read-only: these describe the open batch rather
                     than offering anything to change, since batch settings are fixed at creation. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center" Margin="16,0">
                    <StackPanel VerticalAlignment="Center" IsVisible="{Binding HasOpenBatch}">
                        <TextBlock Text="{Binding OpenBatchLabel}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="{Binding OpenBatchSettingsLabel}" FontSize="11"
                                   Foreground="{DynamicResource InkTertiaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="PAGE" Classes="sectionLabel" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PageCount}" Foreground="{DynamicResource PrimaryHoverBrush}"
                               VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Right: Auto Capture & Camera Model -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Orientation. Lives with AUTO and PAGE rather than in the camera panel
                         because nothing about the camera changes — the rig is bolted down; it is
                         the book that is sideways. Applies to the live view and to every capture
                         taken from here on; pages already in the cart keep the orientation they
                         were shot at. -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="ghost" Content="↺" FontSize="18" Padding="9,2"
                                Command="{Binding RotateLiveViewLeftCommand}"
                                ToolTip.Tip="Rotate the live view 90° left. New captures are saved this way up; pages already captured are left alone."/>
                        <Button Classes="ghost" Content="↻" FontSize="18" Padding="9,2"
                                Command="{Binding RotateLiveViewRightCommand}"
                                ToolTip.Tip="Rotate the live view 90° right. New captures are saved this way up; pages already captured are left alone."/>
                        <!-- Shown only when rotated, so an orientation that silently applies to
                             every capture can never be an invisible mode. -->
                        <Border Background="{DynamicResource PrimaryWashBrush}" CornerRadius="5"
                                Padding="6,2" VerticalAlignment="Center" Margin="2,0,0,0"
                                IsVisible="{Binding IsLiveViewRotated}">
                            <TextBlock Text="{Binding LiveViewRotationLabel}" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHoverBrush}"/>
                        </Border>
                    </StackPanel>

                    <Button Classes="toggle" Classes.active="{Binding IsAutoCapture}"
                            Command="{Binding ToggleAutoCaptureCommand}"
                            Content="AUTO" FontWeight="SemiBold"
                            ToolTip.Tip="Automatically capture once the page is stable, in focus, and different from the last capture. In frame mode this watches the contents of your drawn frames rather than looking for a page boundary."/>
                    <TextBlock Text="{Binding CameraModel}" Foreground="{DynamicResource InkSubtleBrush}"
                               VerticalAlignment="Center" FontSize="12" />
                    <!-- Day/night. Sits with AUTO rather than with the four batch buttons on the
                         left: like AUTO it changes how the operator works, not what the batch is,
                         so it doesn't belong in the row the spec reserves for batch actions. -->
                    <Button Classes="ghost" Command="{Binding CycleThemeCommand}"
                            Content="{Binding ThemeModeLabel}" FontSize="16" Padding="8,4"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding ThemeModeTooltip}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 280">

            <!-- Live View Area -->
            <Border Grid.Column="0" Background="{DynamicResource CanvasBrush}" Margin="10,10,5,5" CornerRadius="10"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    IsVisible="{Binding IsShowingLiveView}">
                <Grid Name="LiveViewContainer">
                    <!-- Only the camera image rotates. The frames deliberately do not: they
                         stay exactly where they were drawn, at the size and in the order they
                         were drawn, and rotating the view never moves or renumbers one.

                         Consequence worth knowing: a frame is stored in the capture's own
                         unrotated coordinates and the crop is taken before the rotation is
                         applied, so with the view turned, a frame selects the region it covers
                         on the *unrotated* page rather than the one under it on screen. Draw
                         frames with the view upright, or set the orientation first.

                         LayoutTransformControl rather than a RenderTransform because layout has
                         to follow: at 90° the image is measured tall-in-a-wide-box, so a
                         portrait page fills the area instead of overflowing and being clipped. -->
                    <!-- Centred explicitly. A LayoutTransformControl left to stretch reports the
                         rotated bounds but keeps the child anchored at the untransformed origin,
                         so at 90° the image sat off to one side of the panel instead of in the
                         middle of it. -->
                    <LayoutTransformControl Name="LiveViewRotator"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform>
                            <RotateTransform Angle="{Binding LiveViewRotation}"/>
                        </LayoutTransformControl.LayoutTransform>
                        <Image Name="LiveViewImageControl" Source="{Binding LiveViewImage}" Stretch="Uniform" IsHitTestVisible="False" />
                    </LayoutTransformControl>

                    <!-- Overlay: interactive fixed frames drawn straight onto the live view.
                         Drag empty space to create one, drag a frame to move it, its handles to
                         resize, and the × badge (or DEL) to remove it — no modal, no calibration
                         shot, editable at any time. -->
                    <controls:FixedFrameOverlayEditor Name="FixedFrameOverlay"
                            Frames="{Binding Frames}"
                            SourceImageSize="{Binding FrameReferenceSize}"
                            CaptureImageSize="{Binding CaptureImageSize}"
                            SelectedFrameIndex="{Binding SelectedFrameIndex, Mode=TwoWay}"
                            IsEditingEnabled="{Binding AreFrameEditsAllowed}"/>

                    <!-- Overlay: readiness badge -->
                    <Border Background="{DynamicResource ScrimBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Padding="12,7" Margin="16" CornerRadius="8" IsHitTestVisible="False"
                            BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding CaptureReadiness}"
                                   Foreground="{Binding CaptureReadiness, Converter={x:Static conv:StatusSeverityConverter.Instance}}"
                                   FontWeight="SemiBold" FontSize="13" />
                    </Border>
                </Grid>
            </Border>

            <!-- Inline lens calibration panel — replaces the live view while it runs. Fixed
                 frames no longer have a panel of their own: they are edited directly on the
                 live view above. -->
            <Border Grid.Column="0" Background="{DynamicResource CanvasBrush}" Margin="10,10,5,5" CornerRadius="10"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    IsVisible="{Binding LensCalibrationViewModel, Converter={x:Static acv:ObjectConverters.IsNotNull}}">
                <views:LensCalibrationPanel DataContext="{Binding LensCalibrationViewModel}"/>
            </Border>

            <!-- Crop Review — replaces the live view in place while reviewing/adjusting a
                 capture, instead of opening a separate popup window. -->
            <Border Grid.Column="0" Background="{DynamicResource CanvasBrush}" Margin="10,10,5,5" CornerRadius="10"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    IsVisible="{Binding ActiveCropReview, Converter={x:Static acv:ObjectConverters.IsNotNull}}">
                <views:CropReviewWindow DataContext="{Binding ActiveCropReview}"/>
            </Border>

            <!-- Right Panel: Status & Settings -->
            <Border Grid.Column="1" Classes="panel" Margin="5,10,10,5" Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <!-- Status Indicators -->
                        <TextBlock Text="STATUS" Classes="sectionLabel" />
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Focus" Foreground="{DynamicResource InkTertiaryBrush}" Width="76" FontSize="13"/>
                                    <TextBlock Text="{Binding FocusStatus}" Foreground="{DynamicResource InkMutedBrush}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Exposure" Foreground="{DynamicResource InkTertiaryBrush}" Width="76" FontSize="13"/>
                                    <TextBlock Text="{Binding ExposureStatus}" Foreground="{DynamicResource InkMutedBrush}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Document" Foreground="{DynamicResource InkTertiaryBrush}" Width="76" FontSize="13"/>
                                    <TextBlock Text="{Binding DocumentStatus}" FontSize="13" FontWeight="Medium"
                                               Foreground="{Binding DocumentStatus, Converter={x:Static conv:StatusSeverityConverter.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Fixed frames. Frame order is page order — it decides which region
                             becomes _frame01, _frame02, ... — so the list shows the mapping
                             explicitly and is reordered by hand, never auto-sorted. -->
                        <TextBlock Text="FRAMES" Classes="sectionLabel" Margin="0,4,0,0"/>
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding FrameSummary}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource InkMutedBrush}"/>

                                <TextBlock Text="Drag on the live view to draw a frame. Drag inside one to move it, its handles to resize, and × or DEL to remove."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource InkTertiaryBrush}"
                                           IsVisible="{Binding !IsFrameMode}"/>

                                <ItemsControl ItemsSource="{Binding FrameList}" IsVisible="{Binding IsFrameMode}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FrameListItem">
                                            <Border CornerRadius="6" Padding="8,5" Margin="0,2"
                                                    Background="{Binding IsSelected, Converter={x:Static conv:BoolToSelectBrushConverter.Instance}}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                                            Background="{Binding Color}"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource InkMutedBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Frame editing is locked while pages are still processing."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningBrush}"
                                           IsVisible="{Binding !AreFrameEditsAllowed}"/>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Add" Classes="secondary" Margin="0,0,6,6"
                                            Command="{Binding AddFrameCommand}"
                                            ToolTip.Tip="Add a frame at a default size — or just drag on the live view to draw one where you want it"/>
                                    <Button Content="Remove" Classes="secondary" Margin="0,0,6,6"
                                            Command="{Binding RemoveSelectedFrameCommand}"/>
                                    <Button Content="↑" Classes="secondary" Margin="0,0,6,6"
                                            Command="{Binding MoveFrameUpCommand}"
                                            ToolTip.Tip="Move the selected frame earlier in page order"/>
                                    <Button Content="↓" Classes="secondary" Margin="0,0,6,6"
                                            Command="{Binding MoveFrameDownCommand}"
                                            ToolTip.Tip="Move the selected frame later in page order"/>
                                    <Button Content="Clear" Classes="secondary" Margin="0,0,6,6"
                                            Command="{Binding ClearAllFramesCommand}"
                                            ToolTip.Tip="Remove every frame and go back to automatic boundary detection"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Capture Button -->
                        <Button Classes="primary" Command="{Binding CaptureCommand}" IsEnabled="{Binding !IsCalibrating}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,15" FontSize="16" Margin="0,6,0,0">
                            CAPTURE
                        </Button>
                        <Button Classes="secondary" Command="{Binding RecaptureCommand}" IsEnabled="{Binding !IsCalibrating}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,11">
                            RECAPTURE
                        </Button>

                        <TextBlock Text="FOCUS" Classes="sectionLabel" Margin="0,4,0,0"/>
                        <!-- Disabled as a group whenever live view isn't streaming: the camera
                             rejects EVF focus commands outright in that state, so an enabled-looking
                             button that silently does nothing is worse than a greyed-out one. All
                             three step sizes are exposed (the medium steps existed in FocusStep but
                             were never surfaced), giving coarse-to-fine control without a slider —
                             the EDSDK offers no continuous focus-distance control to bind one to. -->
                        <!-- Sized to the panel rather than squeezed into it: seven controls
                             across 280px left each one smaller than every other button in the
                             app, which is both hard to hit and visually out of step. -->
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" Height="40"
                              IsEnabled="{Binding IsLiveViewActive}">
                            <Button Grid.Column="0" Classes="secondary" Padding="0" FontSize="14" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="FarLarge"
                                    ToolTip.Tip="Focus farther — large step" Content="⏪"/>
                            <Button Grid.Column="1" Classes="secondary" Padding="0" FontSize="14" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="FarMedium"
                                    ToolTip.Tip="Focus farther — medium step" Content="◀◀"/>
                            <Button Grid.Column="2" Classes="secondary" Padding="0" FontSize="14" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="FarSmall"
                                    ToolTip.Tip="Focus farther — small step" Content="◀"/>
                            <Button Grid.Column="3" Classes="secondary" Padding="0" FontSize="14" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding TriggerAutoFocusCommand}"
                                    ToolTip.Tip="Trigger one autofocus attempt now" Content="AF"/>
                            <Button Grid.Column="4" Classes="secondary" Padding="0" FontSize="14" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="NearSmall"
                                    ToolTip.Tip="Focus nearer — small step" Content="▶"/>
                            <Button Grid.Column="5" Classes="secondary" Padding="0" FontSize="14" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="NearMedium"
                                    ToolTip.Tip="Focus nearer — medium step" Content="▶▶"/>
                            <Button Grid.Column="6" Classes="secondary" Padding="0" FontSize="14" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="NearLarge"
                                    ToolTip.Tip="Focus nearer — large step" Content="⏩"/>
                        </Grid>
                        <TextBlock Text="Live view required for focus" FontSize="10" Opacity="0.6"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"
                                   IsVisible="{Binding !IsLiveViewActive}"/>

                        <TextBlock Text="CAMERA CONTROLS" Classes="sectionLabel" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding CameraControls}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CameraControlItem">
                                    <Grid ColumnDefinitions="*, 120" Margin="0,3">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource InkSubtleBrush}"
                                                   VerticalAlignment="Center" FontSize="13"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                                  IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="core:CameraSettingOption">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Keyboard Shortcuts -->
                        <TextBlock Text="SHORTCUTS" Classes="sectionLabel" Margin="0,4,0,0" />
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Capture" Foreground="{DynamicResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="SPACE" Classes="caption"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Recapture" Foreground="{DynamicResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="R" Classes="caption"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Toggle auto-capture" Foreground="{DynamicResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="A" Classes="caption"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Browse pages" Foreground="{DynamicResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="← →" Classes="caption"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Adjust browsed page" Foreground="{DynamicResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="ENTER" Classes="caption"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Delete frame or page" Foreground="{DynamicResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="DEL" Classes="caption"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══════════════ THUMBNAIL STRIP ═══════════════ -->
        <Border Grid.Row="2" Classes="panel" Margin="10,5,10,5" Padding="10">
            <Grid RowDefinitions="Auto, *">
                <!-- Batch action bar: appears only while at least one thumbnail is selected
                     (ctrl/shift-click). Kept inside the same fixed-height row as the filmstrip
                     itself, not a new row, so it doesn't grow/shrink the overall layout. -->
                <Border Grid.Row="0" Margin="0,0,0,6"
                        Background="{DynamicResource Surface2Brush}" CornerRadius="6" Padding="10,6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Selection actions. Only shown when something is selected, so the bar
                             never offers an action that would do nothing. -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                    IsVisible="{Binding HasSelection}">
                            <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"
                                       Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold"/>
                            <Button Content="Adjust Selected…" Classes="accentGhost"
                                    Command="{Binding ApplyAdjustmentsToSelectedCommand}"
                                    CommandParameter="{Binding $parent[Window]}"
                                    ToolTip.Tip="Set adjustments on one page and apply them to every selected page"/>
                            <Button Content="Delete Selected" Command="{Binding DeleteSelectedCommand}"
                                    CommandParameter="{Binding $parent[Window]}" Classes="iconDanger"/>
                            <Button Content="{Binding SelectAllLabel}" Classes="secondary"
                                    Command="{Binding ToggleSelectAllCommand}"
                                    ToolTip.Tip="Select every page in the cart, or clear the selection if they all are"/>
                            <Button Content="Clear Selection" Click="OnClearSelectionClick" Classes="secondary"/>
                        </StackPanel>

                        <!-- Hint shown in place of the actions when nothing is selected, so the
                             bar teaches the interaction instead of sitting empty. -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                    IsVisible="{Binding !HasSelection}">
                            <Button Content="{Binding SelectAllLabel}" Classes="secondary"
                                    Command="{Binding ToggleSelectAllCommand}"
                                    ToolTip.Tip="Select every page in the cart"/>
                            <TextBlock VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource InkTertiaryBrush}"
                                       Text="Click a page to adjust it · drag to reorder · ctrl-click to select several"/>
                        </StackPanel>

                        <!-- Where the next capture will land, shown only while it isn't the end.
                             Capturing into the middle of a batch is surprising enough that it has
                             to be stated and easy to turn off. -->
                        <Border Grid.Column="1" IsVisible="{Binding HasInsertPoint}" Margin="12,0"
                                Background="{DynamicResource Surface1Brush}" CornerRadius="6" Padding="10,4"
                                BorderBrush="{DynamicResource PrimaryHoverBrush}" BorderThickness="1"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding InsertPointLabel}" FontSize="11.5"
                                           Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                <Button Content="Add at end instead" Classes="secondary" FontSize="11" Padding="8,3"
                                        Command="{Binding ClearInsertPointCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Undo/redo apply to adjustments, which are reprocessed from the
                             preserved original — so stepping back costs only the reprocessing
                             time and never the image. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="secondary" Content="↶ Undo"
                                    Command="{Binding UndoAdjustmentCommand}"
                                    ToolTip.Tip="{Binding UndoLabel}"/>
                            <Button Classes="secondary" Content="↷ Redo"
                                    Command="{Binding RedoAdjustmentCommand}"
                                    ToolTip.Tip="{Binding RedoLabel}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            <!-- AllowDrop belongs on the scroller, not the individual tiles. Avalonia hit-tests
                 the topmost element, and each tile's Button covers its Grid completely — so with
                 AllowDrop only on the Grid the drop was rejected before it could reach a target,
                 which is why dragging appeared to do nothing. One drop zone over the whole strip
                 also means a drop between two tiles still lands somewhere sensible. -->
            <!-- PointerWheelChanged is handled in code-behind: a wheel over a horizontal-only
                 scroller does nothing by default in Avalonia, so the strip looked stuck even
                 though its scrollbar worked. -->
            <ScrollViewer Grid.Row="1" Name="FilmstripScroller" DragDrop.AllowDrop="True"
                          PointerWheelChanged="OnFilmstripWheel"
                          HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding RecentCaptures}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThumbnailItem">
                            <StackPanel Orientation="Horizontal">
                            <!-- Insert point. Sits before each tile and means "start capturing
                                 here", so someone who shot 400 pages can go back and add the ones
                                 they missed at 350 without recapturing the rest. Faint until
                                 hovered so 400 of them don't shout over the pages themselves. -->
                            <!-- Click handler, not a $parent[ItemsControl] compiled binding: that
                                 pattern threw "unable to resolve type" at runtime on the target
                                 machine despite building cleanly — see RecentBatchesDialog's own
                                 note. Every per-row control in this app uses the code-behind
                                 idiom for that reason. -->
                            <Button Classes="insertPoint" Content="+"
                                    Click="OnInsertPointClick"
                                    ToolTip.Tip="Start capturing here — this page and the ones after it shift down"/>
                            <Grid Classes="thumb" Width="104" DragDrop.AllowDrop="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Button Classes="tile"
                                        Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{Binding BorderColor, TargetNullValue={DynamicResource HairlineBrush}}"
                                        BorderThickness="2" CornerRadius="8" Padding="6,6,6,5"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        ToolTip.Tip="Click to adjust this page · drag to reorder · ctrl-click to select"
                                        PointerPressed="OnThumbnailPointerPressed"
                                        PointerMoved="OnThumbnailPointerMoved"
                                        PointerReleased="OnThumbnailPointerReleased"
                                        Click="OnThumbnailClick"
                                        Tag="{Binding JobId}">
                                    <StackPanel Spacing="5">
                                        <Border CornerRadius="5" ClipToBounds="True" Background="{DynamicResource Surface1Brush}">
                                            <Image Source="{Binding Thumbnail}" Height="64" Stretch="Uniform"/>
                                        </Border>
                                        <!-- The page number is what the operator navigates by, so
                                             it reads as the tile's label rather than a caption. -->
                                        <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                   HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={x:Static conv:StatusSeverityConverter.Instance}}"/>
                                            <TextBlock Text="{Binding Status}" FontSize="9.5"
                                                       Foreground="{DynamicResource InkSubtleBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="66"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Selection ring. Non-hit-testable so it never steals a click
                                     from the tile underneath it. -->
                                <Border IsVisible="{Binding IsSelected}" CornerRadius="8"
                                        BorderBrush="{DynamicResource PrimaryHoverBrush}"
                                        BorderThickness="2.5" IsHitTestVisible="False"/>

                                <!-- The arrow-key browse cursor. Deliberately a different mark
                                     from the selection ring: browsing to look at a page and
                                     selecting it for a batch action are different acts, and one
                                     shouldn't look like the other. -->
                                <Border IsVisible="{Binding IsCurrent}" CornerRadius="8"
                                        BorderBrush="{DynamicResource WarningBrush}"
                                        BorderThickness="2" IsHitTestVisible="False"/>

                                <!-- Select and delete sit in a top strip that appears on hover, or
                                     stays put while selected. They used to be two 20px circles
                                     pinned outside the tile's corners on negative margins, which
                                     overlapped the neighbouring tile and were easy to hit by
                                     accident. Real labels and full-height targets are far harder
                                     to mis-click. -->
                                <Grid Classes="tileActions" VerticalAlignment="Top" ColumnDefinitions="Auto,*,Auto"
                                      Margin="3,3,3,0">
                                    <Button Grid.Column="0" Classes="tileAction" Click="OnThumbnailSelectClick"
                                            ToolTip.Tip="Select this page for batch actions"
                                            Content="{Binding IsSelected, Converter={x:Static conv:BoolToSelectGlyphConverter.Instance}}"/>
                                    <Button Grid.Column="2" Classes="tileAction danger" Click="OnDeleteThumbnailClick"
                                            ToolTip.Tip="Delete this page from the batch"
                                            Content="✕"/>
                                </Grid>
                            </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The trailing insert point. Every other "+" means "insert before this page";
                     this one means "carry on at the end", which is also how to cancel an insert
                     point you set earlier without hunting for the banner's button. -->
                <Button Classes="insertPoint" Content="+"
                        Command="{Binding ClearInsertPointCommand}"
                        IsVisible="{Binding HasOpenBatch}"
                        ToolTip.Tip="Capture at the end of the batch"/>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════ STATUS BAR ═══════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource Surface1Brush}" Padding="12,7"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{DynamicResource InkMutedBrush}" FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Micrographics v0.4.0" Foreground="{DynamicResource InkTertiaryBrush}"
                           FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
