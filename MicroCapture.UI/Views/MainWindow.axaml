<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MicroCapture.UI.ViewModels"
        xmlns:views="using:MicroCapture.UI.Views"
        xmlns:conv="using:MicroCapture.UI.Converters"
        xmlns:acv="using:Avalonia.Data.Converters"
        xmlns:core="using:MicroCapture.Core.Interfaces"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        x:Class="MicroCapture.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Micrographics Capture Software"
        Width="1400" Height="800"
        MinWidth="960" MinHeight="640"
        Background="{StaticResource CanvasBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, 112, Auto">

        <!-- ═══════════════ TOP TOOLBAR ═══════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Surface1Brush}" Padding="14,10"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <!-- Left: Connection & batch -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                <WrapPanel.Styles>
                    <Style Selector="WrapPanel > :is(Control)">
                        <Setter Property="Margin" Value="0,0,8,4"/>
                    </Style>
                </WrapPanel.Styles>
                    <Button Classes="toggle" Classes.active="{Binding IsConnected}"
                            Command="{Binding ConnectCommand}"
                            Content="{Binding ConnectionStatus}"/>
                    <TextBox Text="{Binding ProjectCode}" Watermark="Project Code" Width="120"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource InkBrush}"
                             BorderBrush="{StaticResource HairlineStrongBrush}" CornerRadius="8"/>
                    <TextBox Text="{Binding BatchCode}" Watermark="Batch Code" Width="120"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource InkBrush}"
                             BorderBrush="{StaticResource HairlineStrongBrush}" CornerRadius="8"/>
                    <CheckBox IsChecked="{Binding SplitBookPages}" Content="Split Book Pages"
                              Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                    <CheckBox IsChecked="{Binding UseFixedFrames}" Content="Use Fixed Frames"
                              ToolTip.Tip="Crop every capture in this batch to operator-calibrated fixed rectangles instead of per-shot auto-detection"
                              Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                    <CheckBox IsChecked="{Binding DewarpEnabled}" Content="Book Curve Correction"
                              ToolTip.Tip="Corrects spine-curvature distortion on bound-book captures — flattens the bulge near the gutter so text lines come out straight. Runs in the background queue, so it never affects capture speed."
                              Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                    <CheckBox IsChecked="{Binding BinarizeEnabled}" Content="Binarize (B&amp;W)"
                              ToolTip.Tip="Thresholds every processed page to pure black-and-white (Sauvola local threshold) and writes it as a true 1-bit CCITT G4 TIFF — much smaller files and crisper OCR input, but loses all color/grayscale content. Not reversible after export."
                              Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                    <CheckBox IsChecked="{Binding BleedthroughEnabled}" Content="Bleedthrough Suppression"
                              ToolTip.Tip="Softens show-through from text/images printed on the reverse side of a thin page. Not effective on colored-image bleedthrough — grayscale/text show-through only."
                              Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding DefaultExportFormat}"
                              Width="90" ToolTip.Tip="Default export format for the next batch"/>
                    <ComboBox ItemsSource="{Binding AvailableDpiOptions}" SelectedItem="{Binding SelectedDpi}"
                              Width="90" ToolTip.Tip="DPI tagged on every processed TIFF in this batch. 150 is the baseline (native captured pixel size); higher values upsample the output — 600 DPI is roughly 4x the pixel dimensions of 150 DPI.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='{}{0} DPI'}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="primary" Command="{Binding StartBatchCommand}" Content="Start Batch"
                            Margin="6,0,0,0"/>
                    <Button Classes="secondary" Command="{Binding CalibrateFramesCommand}"
                            Content="{Binding CalibrateButtonLabel}"
                            IsVisible="{Binding ShowCalibrateButton}"/>
                    <Button Classes="secondary" Command="{Binding CalibrateLensCommand}"
                            Content="Calibrate Lens"
                            ToolTip.Tip="One-time camera lens distortion calibration against a printed ChArUco board — corrects barrel/pincushion distortion before any other geometric correction runs"
                            IsVisible="{Binding IsConnected}"/>
                    <Button Classes="secondary" Width="96" Margin="10,0,0,0" Click="OnExportFormatButtonClick"
                            ToolTip.Tip="Export format">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                            <TextBlock Text="{Binding ExportFormat}" />
                            <TextBlock Text="▾" FontSize="11" Opacity="0.7" Foreground="{StaticResource InkSubtleBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary" Command="{Binding RunOcrCommand}" Content="Run OCR"
                            ToolTip.Tip="Run OCR now on this batch's finished pages, so searchable text is ready ahead of a PDF export"/>
                    <Button Classes="secondary" Command="{Binding ExportBatchCommand}" Content="Export Batch"/>
                </WrapPanel>

                <!-- Center: Page Count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="PAGE" Classes="sectionLabel" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PageCount}" Foreground="{StaticResource PrimaryHoverBrush}"
                               VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Right: Auto Capture & Camera Model -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Classes="toggle" Classes.active="{Binding IsAutoCapture}"
                            Command="{Binding ToggleAutoCaptureCommand}"
                            IsVisible="{Binding IsAutoCaptureAvailable}"
                            Content="AUTO" FontWeight="SemiBold"
                            ToolTip.Tip="Automatically capture once a page is stable, in focus, and different from the last capture"/>
                    <TextBlock Text="{Binding CameraModel}" Foreground="{StaticResource InkSubtleBrush}"
                               VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 280">

            <!-- Live View Area -->
            <Border Grid.Column="0" Background="{StaticResource CanvasBrush}" Margin="10,10,5,5" CornerRadius="10"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    IsVisible="{Binding !IsCalibrating}">
                <Grid Name="LiveViewContainer">
                    <Image Name="LiveViewImageControl" Source="{Binding LiveViewImage}" Stretch="Uniform" IsHitTestVisible="False" />
                    <!-- Overlay: active fixed-frame outlines, drawn read-only while shooting so
                         the operator can position paper before pressing capture. -->
                    <Canvas Name="FixedFrameOverlayCanvas" Background="Transparent" IsHitTestVisible="False"/>
                    <!-- Overlay: readiness badge -->
                    <Border Background="#cc0f1011" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Padding="12,7" Margin="16" CornerRadius="8" IsHitTestVisible="False"
                            BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding CaptureReadiness}"
                                   Foreground="{Binding CaptureReadiness, Converter={x:Static conv:StatusSeverityConverter.Instance}}"
                                   FontWeight="SemiBold" FontSize="13" />
                    </Border>
                </Grid>
            </Border>

            <!-- Inline calibration panels — replace live view during calibration. Both share
                 the same IsCalibrating gate (blocks Capture/Recapture), but each panel only
                 shows for its own calibration type, distinguished by which ViewModel is set. -->
            <Border Grid.Column="0" Background="{StaticResource CanvasBrush}" Margin="10,10,5,5" CornerRadius="10"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    IsVisible="{Binding CalibrationViewModel, Converter={x:Static acv:ObjectConverters.IsNotNull}}">
                <views:FrameCalibrationPanel DataContext="{Binding CalibrationViewModel}"/>
            </Border>
            <Border Grid.Column="0" Background="{StaticResource CanvasBrush}" Margin="10,10,5,5" CornerRadius="10"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    IsVisible="{Binding LensCalibrationViewModel, Converter={x:Static acv:ObjectConverters.IsNotNull}}">
                <views:LensCalibrationPanel DataContext="{Binding LensCalibrationViewModel}"/>
            </Border>

            <!-- Right Panel: Status & Settings -->
            <Border Grid.Column="1" Classes="panel" Margin="5,10,10,5" Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <!-- Status Indicators -->
                        <TextBlock Text="STATUS" Classes="sectionLabel" />
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Focus" Foreground="{StaticResource InkTertiaryBrush}" Width="76" FontSize="13"/>
                                    <TextBlock Text="{Binding FocusStatus}" Foreground="{StaticResource InkMutedBrush}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Exposure" Foreground="{StaticResource InkTertiaryBrush}" Width="76" FontSize="13"/>
                                    <TextBlock Text="{Binding ExposureStatus}" Foreground="{StaticResource InkMutedBrush}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Document" Foreground="{StaticResource InkTertiaryBrush}" Width="76" FontSize="13"/>
                                    <TextBlock Text="{Binding DocumentStatus}" FontSize="13" FontWeight="Medium"
                                               Foreground="{Binding DocumentStatus, Converter={x:Static conv:StatusSeverityConverter.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="CAMERA CONTROLS" Classes="sectionLabel" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding CameraControls}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CameraControlItem">
                                    <Grid ColumnDefinitions="*, 120" Margin="0,3">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource InkSubtleBrush}"
                                                   VerticalAlignment="Center" FontSize="13"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                                  IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="core:CameraSettingOption">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="FOCUS" Classes="sectionLabel" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Stretch">
                            <Button Classes="secondary" Width="44" Padding="0,7" FontSize="12"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="FarLarge"
                                    ToolTip.Tip="Focus farther — large step" Content="◀◀"/>
                            <Button Classes="secondary" Width="44" Padding="0,7" FontSize="12"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="FarSmall"
                                    ToolTip.Tip="Focus farther — small step" Content="◀"/>
                            <Button Classes="secondary" Width="44" Padding="0,7" FontSize="12"
                                    Command="{Binding TriggerAutoFocusCommand}"
                                    ToolTip.Tip="Trigger one autofocus attempt now" Content="AF"/>
                            <Button Classes="secondary" Width="44" Padding="0,7" FontSize="12"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="NearSmall"
                                    ToolTip.Tip="Focus nearer — small step" Content="▶"/>
                            <Button Classes="secondary" Width="44" Padding="0,7" FontSize="12"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="NearLarge"
                                    ToolTip.Tip="Focus nearer — large step" Content="▶▶"/>
                        </StackPanel>

                        <!-- Capture Button -->
                        <Button Classes="primary" Command="{Binding CaptureCommand}" IsEnabled="{Binding !IsCalibrating}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,15" FontSize="16" Margin="0,6,0,0">
                            CAPTURE
                        </Button>
                        <Button Classes="secondary" Command="{Binding RecaptureCommand}" IsEnabled="{Binding !IsCalibrating}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,11">
                            RECAPTURE
                        </Button>

                        <!-- Keyboard Shortcuts -->
                        <TextBlock Text="SHORTCUTS" Classes="sectionLabel" Margin="0,4,0,0" />
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Capture" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="SPACE" Classes="caption"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Recapture" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="R" Classes="caption"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Toggle auto-capture" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="A" Classes="caption"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Browse pages" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="← →" Classes="caption"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══════════════ THUMBNAIL STRIP ═══════════════ -->
        <Border Grid.Row="2" Classes="panel" Margin="10,5,10,5" Padding="10">
            <Grid RowDefinitions="Auto, *">
                <!-- Batch action bar: appears only while at least one thumbnail is selected
                     (ctrl/shift-click). Kept inside the same fixed-height row as the filmstrip
                     itself, not a new row, so it doesn't grow/shrink the overall layout. -->
                <Border Grid.Row="0" IsVisible="{Binding HasSelection}" Margin="0,0,0,6"
                        Background="{StaticResource Surface2Brush}" CornerRadius="6" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"
                                   Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" FontSize="12"/>
                        <Button Content="Apply Adjustments…" Command="{Binding ApplyAdjustmentsToSelectedCommand}" Classes="accentGhost"/>
                        <Button Content="Delete Selected" Command="{Binding DeleteSelectedAsyncCommand}"
                                CommandParameter="{Binding $parent[Window]}" Classes="iconDanger"/>
                        <Button Content="Clear Selection" Click="OnClearSelectionClick" Classes="secondary"/>
                    </StackPanel>
                </Border>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding RecentCaptures}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThumbnailItem">
                            <Grid Classes="thumb" Width="100">
                                <Button Background="{StaticResource Surface2Brush}"
                                        BorderBrush="{Binding BorderColor, TargetNullValue={StaticResource HairlineBrush}}"
                                        BorderThickness="2" CornerRadius="8" Padding="6"
                                        ToolTip.Tip="Click to open crop review — ctrl/shift-click to select for batch actions"
                                        PointerPressed="OnThumbnailPointerPressed"
                                        Click="OnThumbnailClick"
                                        Tag="{Binding JobId}">
                                    <StackPanel Spacing="6">
                                        <Border CornerRadius="6" ClipToBounds="True" Background="{StaticResource Surface1Brush}">
                                            <Image Source="{Binding Thumbnail}" Height="62" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={x:Static conv:StatusSeverityConverter.Instance}}"/>
                                            <TextBlock Text="{Binding PageNumber, StringFormat='P{0:D4}'}"
                                                       Foreground="{StaticResource InkMutedBrush}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{StaticResource InkSubtleBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                                <Border IsVisible="{Binding IsSelected}" CornerRadius="8" BorderBrush="{StaticResource PrimaryHoverBrush}"
                                        BorderThickness="3" IsHitTestVisible="False"/>
                                <Ellipse IsVisible="{Binding IsSelected}" Width="16" Height="16" Fill="{StaticResource PrimaryHoverBrush}"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" IsHitTestVisible="False"/>
                                <Button Content="✕" Width="20" Height="20" Padding="0" FontSize="10" Classes="iconDanger"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                        ToolTip.Tip="Delete this capture (excludes it from processing and export)"
                                        Click="OnDeleteThumbnailClick" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════ STATUS BAR ═══════════════ -->
        <Border Grid.Row="3" Background="{StaticResource Surface1Brush}" Padding="12,7"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{StaticResource InkMutedBrush}" FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Micrographics v0.4.0" Foreground="{StaticResource InkTertiaryBrush}"
                           FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
