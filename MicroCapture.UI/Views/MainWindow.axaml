<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MicroCapture.UI.ViewModels"
        xmlns:views="using:MicroCapture.UI.Views"
        xmlns:controls="using:MicroCapture.UI.Controls"
        xmlns:conv="using:MicroCapture.UI.Converters"
        xmlns:acv="using:Avalonia.Data.Converters"
        xmlns:core="using:MicroCapture.Core.Interfaces"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        x:Class="MicroCapture.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MicroCapture"
        Icon="/Assets/microcapture-icon.png"
        Width="1400" Height="800"
        MinWidth="960" MinHeight="640"
        Background="{StaticResource CanvasBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Filmstrip row (3rd) was 112px — barely enough for the thumbnail image row alone. With
         the status dot+text row added below the page-number row, total content height (image +
         two text rows + button/border padding) runs to ~140px, and since the inner ScrollViewer
         only allows horizontal scrolling (see the filmstrip below), whatever didn't fit was
         silently clipped from the bottom — the status Ellipse/TextBlock specifically, since they
         sit last in each tile's StackPanel. Confirmed cause of "no status text/dot shown at all"
         despite Status actually being set correctly. -->
    <Grid RowDefinitions="Auto, *, 140, Auto">

        <!-- ═══════════════ TOP TOOLBAR ═══════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Surface1Brush}" Padding="14,10"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <!-- Only the four buttons the workflow is built around live up here:
                     Connect/Disconnect, New Batch, Open Batch, Finalize Batch. Everything that
                     used to sit alongside them — project/batch codes, DPI, format, and the
                     processing toggles — now belongs to the New Batch dialog, where it is chosen
                     once for the whole batch instead of being adjustable mid-batch (which
                     produced batches whose pages didn't match each other). Run OCR moved into
                     Finalize, which already offers OCR as part of the export. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="toggle" Classes.active="{Binding IsConnected}"
                            Command="{Binding ConnectCommand}"
                            Content="{Binding ConnectionStatus}"
                            ToolTip.Tip="Connect or disconnect the camera"/>
                    <Button Classes="primary" Command="{Binding NewBatchCommand}"
                            CommandParameter="{Binding $parent[Window]}" Content="New Batch"
                            ToolTip.Tip="Create a batch — choose where it's saved, its DPI, format, and processing options"/>
                    <Button Classes="secondary" Command="{Binding OpenBatchCommand}"
                            CommandParameter="{Binding $parent[Window]}" Content="Open Batch"
                            ToolTip.Tip="Continue an existing batch, including one started on another workstation"/>
                    <Button Classes="primary" Command="{Binding OpenFinalizeBatchCommand}"
                            CommandParameter="{Binding $parent[Window]}" Content="Finalize Batch"
                            ToolTip.Tip="Review, reorder, and export this batch's pages — choose format, OCR, filename and destination"/>
                    <Button Classes="secondary" Command="{Binding CalibrateLensCommand}"
                            Content="Calibrate Lens"
                            ToolTip.Tip="One-time camera lens distortion calibration against a printed ChArUco board — corrects barrel/pincushion distortion before any other geometric correction runs"
                            IsVisible="{Binding IsConnected}"/>
                </StackPanel>

                <!-- Current batch and page count. Read-only: these describe the open batch rather
                     than offering anything to change, since batch settings are fixed at creation. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center" Margin="16,0">
                    <StackPanel VerticalAlignment="Center" IsVisible="{Binding HasOpenBatch}">
                        <TextBlock Text="{Binding OpenBatchLabel}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="{Binding OpenBatchSettingsLabel}" FontSize="11"
                                   Foreground="{StaticResource InkTertiaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="PAGE" Classes="sectionLabel" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PageCount}" Foreground="{StaticResource PrimaryHoverBrush}"
                               VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Right: Auto Capture & Camera Model -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Classes="toggle" Classes.active="{Binding IsAutoCapture}"
                            Command="{Binding ToggleAutoCaptureCommand}"
                            Content="AUTO" FontWeight="SemiBold"
                            ToolTip.Tip="Automatically capture once the page is stable, in focus, and different from the last capture. In frame mode this watches the contents of your drawn frames rather than looking for a page boundary."/>
                    <TextBlock Text="{Binding CameraModel}" Foreground="{StaticResource InkSubtleBrush}"
                               VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 280">

            <!-- Live View Area -->
            <Border Grid.Column="0" Background="{StaticResource CanvasBrush}" Margin="10,10,5,5" CornerRadius="10"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    IsVisible="{Binding IsShowingLiveView}">
                <Grid Name="LiveViewContainer">
                    <Image Name="LiveViewImageControl" Source="{Binding LiveViewImage}" Stretch="Uniform" IsHitTestVisible="False" />
                    <!-- Overlay: interactive fixed frames drawn straight onto the live view.
                         Drag empty space to create one, drag a frame to move it, its handles to
                         resize, and the × badge (or DEL) to remove it — no modal, no calibration
                         shot, editable at any time. -->
                    <controls:FixedFrameOverlayEditor Name="FixedFrameOverlay"
                            Frames="{Binding Frames}"
                            SourceImageSize="{Binding FrameReferenceSize}"
                            CaptureImageSize="{Binding CaptureImageSize}"
                            SelectedFrameIndex="{Binding SelectedFrameIndex, Mode=TwoWay}"
                            IsEditingEnabled="{Binding AreFrameEditsAllowed}"/>
                    <!-- Overlay: readiness badge -->
                    <Border Background="#cc0f1011" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Padding="12,7" Margin="16" CornerRadius="8" IsHitTestVisible="False"
                            BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding CaptureReadiness}"
                                   Foreground="{Binding CaptureReadiness, Converter={x:Static conv:StatusSeverityConverter.Instance}}"
                                   FontWeight="SemiBold" FontSize="13" />
                    </Border>
                </Grid>
            </Border>

            <!-- Inline lens calibration panel — replaces the live view while it runs. Fixed
                 frames no longer have a panel of their own: they are edited directly on the
                 live view above. -->
            <Border Grid.Column="0" Background="{StaticResource CanvasBrush}" Margin="10,10,5,5" CornerRadius="10"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    IsVisible="{Binding LensCalibrationViewModel, Converter={x:Static acv:ObjectConverters.IsNotNull}}">
                <views:LensCalibrationPanel DataContext="{Binding LensCalibrationViewModel}"/>
            </Border>

            <!-- Crop Review — replaces the live view in place while reviewing/adjusting a
                 capture, instead of opening a separate popup window. -->
            <Border Grid.Column="0" Background="{StaticResource CanvasBrush}" Margin="10,10,5,5" CornerRadius="10"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    IsVisible="{Binding ActiveCropReview, Converter={x:Static acv:ObjectConverters.IsNotNull}}">
                <views:CropReviewWindow DataContext="{Binding ActiveCropReview}"/>
            </Border>

            <!-- Right Panel: Status & Settings -->
            <Border Grid.Column="1" Classes="panel" Margin="5,10,10,5" Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <!-- Status Indicators -->
                        <TextBlock Text="STATUS" Classes="sectionLabel" />
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Focus" Foreground="{StaticResource InkTertiaryBrush}" Width="76" FontSize="13"/>
                                    <TextBlock Text="{Binding FocusStatus}" Foreground="{StaticResource InkMutedBrush}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Exposure" Foreground="{StaticResource InkTertiaryBrush}" Width="76" FontSize="13"/>
                                    <TextBlock Text="{Binding ExposureStatus}" Foreground="{StaticResource InkMutedBrush}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Document" Foreground="{StaticResource InkTertiaryBrush}" Width="76" FontSize="13"/>
                                    <TextBlock Text="{Binding DocumentStatus}" FontSize="13" FontWeight="Medium"
                                               Foreground="{Binding DocumentStatus, Converter={x:Static conv:StatusSeverityConverter.Instance}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Fixed frames. Frame order is page order — it decides which region
                             becomes _frame01, _frame02, ... — so the list shows the mapping
                             explicitly and is reordered by hand, never auto-sorted. -->
                        <TextBlock Text="FRAMES" Classes="sectionLabel" Margin="0,4,0,0"/>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding FrameSummary}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource InkMutedBrush}"/>

                                <TextBlock Text="Drag on the live view to draw a frame. Drag inside one to move it, its handles to resize, and × or DEL to remove."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource InkTertiaryBrush}"
                                           IsVisible="{Binding !IsFrameMode}"/>

                                <ItemsControl ItemsSource="{Binding FrameList}" IsVisible="{Binding IsFrameMode}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FrameListItem">
                                            <Border CornerRadius="6" Padding="8,5" Margin="0,2"
                                                    Background="{Binding IsSelected, Converter={x:Static conv:BoolToSelectBrushConverter.Instance}}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                                            Background="{Binding Color}"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{StaticResource InkMutedBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Frame editing is locked while pages are still processing."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource WarningBrush}"
                                           IsVisible="{Binding !AreFrameEditsAllowed}"/>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Add" Classes="secondary" Margin="0,0,6,6"
                                            Command="{Binding AddFrameCommand}"
                                            ToolTip.Tip="Add a frame at a default size — or just drag on the live view to draw one where you want it"/>
                                    <Button Content="Remove" Classes="secondary" Margin="0,0,6,6"
                                            Command="{Binding RemoveSelectedFrameCommand}"/>
                                    <Button Content="↑" Classes="secondary" Margin="0,0,6,6"
                                            Command="{Binding MoveFrameUpCommand}"
                                            ToolTip.Tip="Move the selected frame earlier in page order"/>
                                    <Button Content="↓" Classes="secondary" Margin="0,0,6,6"
                                            Command="{Binding MoveFrameDownCommand}"
                                            ToolTip.Tip="Move the selected frame later in page order"/>
                                    <Button Content="Clear" Classes="secondary" Margin="0,0,6,6"
                                            Command="{Binding ClearAllFramesCommand}"
                                            ToolTip.Tip="Remove every frame and go back to automatic boundary detection"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="CAMERA CONTROLS" Classes="sectionLabel" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding CameraControls}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CameraControlItem">
                                    <Grid ColumnDefinitions="*, 120" Margin="0,3">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource InkSubtleBrush}"
                                                   VerticalAlignment="Center" FontSize="13"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                                  IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="core:CameraSettingOption">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="FOCUS" Classes="sectionLabel" Margin="0,4,0,0"/>
                        <!-- Disabled as a group whenever live view isn't streaming: the camera
                             rejects EVF focus commands outright in that state, so an enabled-looking
                             button that silently does nothing is worse than a greyed-out one. All
                             three step sizes are exposed (the medium steps existed in FocusStep but
                             were never surfaced), giving coarse-to-fine control without a slider —
                             the EDSDK offers no continuous focus-distance control to bind one to. -->
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*"
                              IsEnabled="{Binding IsLiveViewActive}">
                            <Button Grid.Column="0" Classes="secondary" Padding="0,7" FontSize="11" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="FarLarge"
                                    ToolTip.Tip="Focus farther — large step" Content="⏪"/>
                            <Button Grid.Column="1" Classes="secondary" Padding="0,7" FontSize="11" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="FarMedium"
                                    ToolTip.Tip="Focus farther — medium step" Content="◀◀"/>
                            <Button Grid.Column="2" Classes="secondary" Padding="0,7" FontSize="11" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="FarSmall"
                                    ToolTip.Tip="Focus farther — small step" Content="◀"/>
                            <Button Grid.Column="3" Classes="secondary" Padding="0,7" FontSize="11" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding TriggerAutoFocusCommand}"
                                    ToolTip.Tip="Trigger one autofocus attempt now" Content="AF"/>
                            <Button Grid.Column="4" Classes="secondary" Padding="0,7" FontSize="11" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="NearSmall"
                                    ToolTip.Tip="Focus nearer — small step" Content="▶"/>
                            <Button Grid.Column="5" Classes="secondary" Padding="0,7" FontSize="11" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="NearMedium"
                                    ToolTip.Tip="Focus nearer — medium step" Content="▶▶"/>
                            <Button Grid.Column="6" Classes="secondary" Padding="0,7" FontSize="11" Margin="1,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding NudgeFocusCommand}" CommandParameter="NearLarge"
                                    ToolTip.Tip="Focus nearer — large step" Content="⏩"/>
                        </Grid>
                        <TextBlock Text="Live view required for focus" FontSize="10" Opacity="0.6"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"
                                   IsVisible="{Binding !IsLiveViewActive}"/>

                        <!-- Capture Button -->
                        <Button Classes="primary" Command="{Binding CaptureCommand}" IsEnabled="{Binding !IsCalibrating}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,15" FontSize="16" Margin="0,6,0,0">
                            CAPTURE
                        </Button>
                        <Button Classes="secondary" Command="{Binding RecaptureCommand}" IsEnabled="{Binding !IsCalibrating}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,11">
                            RECAPTURE
                        </Button>

                        <!-- Keyboard Shortcuts -->
                        <TextBlock Text="SHORTCUTS" Classes="sectionLabel" Margin="0,4,0,0" />
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Capture" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="SPACE" Classes="caption"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Recapture" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="R" Classes="caption"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Toggle auto-capture" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="A" Classes="caption"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Browse pages" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="← →" Classes="caption"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Remove frame" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Width="130"/>
                                    <TextBlock Text="DEL" Classes="caption"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══════════════ THUMBNAIL STRIP ═══════════════ -->
        <Border Grid.Row="2" Classes="panel" Margin="10,5,10,5" Padding="10">
            <Grid RowDefinitions="Auto, *">
                <!-- Batch action bar: appears only while at least one thumbnail is selected
                     (ctrl/shift-click). Kept inside the same fixed-height row as the filmstrip
                     itself, not a new row, so it doesn't grow/shrink the overall layout. -->
                <Border Grid.Row="0" Margin="0,0,0,6"
                        Background="{StaticResource Surface2Brush}" CornerRadius="6" Padding="10,6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Selection actions. Only shown when something is selected, so the bar
                             never offers an action that would do nothing. -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                    IsVisible="{Binding HasSelection}">
                            <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"
                                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold"/>
                            <Button Content="Adjust Selected…" Classes="accentGhost"
                                    Command="{Binding ApplyAdjustmentsToSelectedCommand}"
                                    CommandParameter="{Binding $parent[Window]}"
                                    ToolTip.Tip="Set adjustments on one page and apply them to every selected page"/>
                            <Button Content="Delete Selected" Command="{Binding DeleteSelectedCommand}"
                                    CommandParameter="{Binding $parent[Window]}" Classes="iconDanger"/>
                            <Button Content="Clear Selection" Click="OnClearSelectionClick" Classes="secondary"/>
                        </StackPanel>

                        <!-- Hint shown in place of the actions when nothing is selected, so the
                             bar teaches the interaction instead of sitting empty. -->
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource InkTertiaryBrush}"
                                   IsVisible="{Binding !HasSelection}"
                                   Text="Click a page to adjust it · drag to reorder · ctrl-click to select several"/>

                        <!-- Undo/redo apply to adjustments, which are reprocessed from the
                             preserved original — so stepping back costs only the reprocessing
                             time and never the image. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="secondary" Content="↶ Undo"
                                    Command="{Binding UndoAdjustmentCommand}"
                                    ToolTip.Tip="{Binding UndoLabel}"/>
                            <Button Classes="secondary" Content="↷ Redo"
                                    Command="{Binding RedoAdjustmentCommand}"
                                    ToolTip.Tip="{Binding RedoLabel}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            <!-- AllowDrop belongs on the scroller, not the individual tiles. Avalonia hit-tests
                 the topmost element, and each tile's Button covers its Grid completely — so with
                 AllowDrop only on the Grid the drop was rejected before it could reach a target,
                 which is why dragging appeared to do nothing. One drop zone over the whole strip
                 also means a drop between two tiles still lands somewhere sensible. -->
            <ScrollViewer Grid.Row="1" Name="FilmstripScroller" DragDrop.AllowDrop="True"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding RecentCaptures}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThumbnailItem">
                            <Grid Classes="thumb" Width="104" DragDrop.AllowDrop="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Button Classes="tile"
                                        Background="{StaticResource Surface2Brush}"
                                        BorderBrush="{Binding BorderColor, TargetNullValue={StaticResource HairlineBrush}}"
                                        BorderThickness="2" CornerRadius="8" Padding="6,6,6,5"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        ToolTip.Tip="Click to adjust this page · drag to reorder · ctrl-click to select"
                                        PointerPressed="OnThumbnailPointerPressed"
                                        PointerMoved="OnThumbnailPointerMoved"
                                        PointerReleased="OnThumbnailPointerReleased"
                                        Click="OnThumbnailClick"
                                        Tag="{Binding JobId}">
                                    <StackPanel Spacing="5">
                                        <Border CornerRadius="5" ClipToBounds="True" Background="{StaticResource Surface1Brush}">
                                            <Image Source="{Binding Thumbnail}" Height="60" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Text="{Binding PageNumber, StringFormat='PAGE {0}'}"
                                                   HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkMutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={x:Static conv:StatusSeverityConverter.Instance}}"/>
                                            <TextBlock Text="{Binding Status}" FontSize="9.5"
                                                       Foreground="{StaticResource InkSubtleBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="66"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Selection ring. Non-hit-testable so it never steals a click
                                     from the tile underneath it. -->
                                <Border IsVisible="{Binding IsSelected}" CornerRadius="8"
                                        BorderBrush="{StaticResource PrimaryHoverBrush}"
                                        BorderThickness="2.5" IsHitTestVisible="False"/>

                                <!-- Select and delete sit in a top strip that appears on hover, or
                                     stays put while selected. They used to be two 20px circles
                                     pinned outside the tile's corners on negative margins, which
                                     overlapped the neighbouring tile and were easy to hit by
                                     accident. Real labels and full-height targets are far harder
                                     to mis-click. -->
                                <Grid Classes="tileActions" VerticalAlignment="Top" ColumnDefinitions="Auto,*,Auto"
                                      Margin="3,3,3,0">
                                    <Button Grid.Column="0" Classes="tileAction" Click="OnThumbnailSelectClick"
                                            ToolTip.Tip="Select this page for batch actions"
                                            Content="{Binding IsSelected, Converter={x:Static conv:BoolToSelectGlyphConverter.Instance}}"/>
                                    <Button Grid.Column="2" Classes="tileAction danger" Click="OnDeleteThumbnailClick"
                                            ToolTip.Tip="Delete this page from the batch"
                                            Content="✕"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════ STATUS BAR ═══════════════ -->
        <Border Grid.Row="3" Background="{StaticResource Surface1Brush}" Padding="12,7"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{StaticResource InkMutedBrush}" FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Micrographics v0.4.0" Foreground="{StaticResource InkTertiaryBrush}"
                           FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
