<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MicroCapture.UI.ViewModels"
        x:Class="MicroCapture.UI.Views.CropReviewWindow"
        x:DataType="vm:CropReviewViewModel"
        Title="Crop Review"
        Width="1280" Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#12121e">
    <Grid RowDefinitions="*, Auto">
        <Grid Grid.Row="0" ColumnDefinitions="2*, 1*">
            <!-- Main Image & Interactive Crop Canvas Area -->
            <Border Grid.Column="0" Background="#080811" Margin="12" CornerRadius="8" ClipToBounds="True">
                <Grid Name="ContainerGrid">
                    <Image Name="TargetImage"
                           Source="{Binding Image}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    <Canvas Name="OverlayCanvas"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>
                </Grid>
            </Border>

            <!-- Live Preview -->
            <Border Grid.Column="1" Background="#080811" Margin="0,12,12,12" CornerRadius="8" Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock Text="LIVE PREVIEW" Foreground="#00d2ff" FontWeight="Bold" FontSize="12"/>
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                           IsVisible="{Binding IsSinglePage}" MaxHeight="500"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSplitBookPages}">
                        <StackPanel Spacing="4" Width="150">
                            <TextBlock Text="Left" Foreground="#a0a0b0" FontSize="11"/>
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                        </StackPanel>
                        <StackPanel Spacing="4" Width="150">
                            <TextBlock Text="Right" Foreground="#a0a0b0" FontSize="11"/>
                            <Image Source="{Binding SecondaryPreviewImage}" Stretch="Uniform"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="1" Margin="12,0,12,12" Background="#1c1c2e" Padding="14,10" CornerRadius="8">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Mode & Instruction Text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Split Book Pages" IsVisible="{Binding IsSplitBookPages}"
                               Foreground="#00d2ff" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Single Page Crop" IsVisible="{Binding IsSinglePage}"
                               Foreground="#00d2ff" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BoundaryHintText}"
                               Foreground="#a0a0b0" VerticalAlignment="Center" FontSize="13"/>
                    <Button Content="Switch to page-by-page" Command="{Binding ToggleSplitEditModeCommand}"
                            IsVisible="{Binding IsLineSplitMode}"
                            Background="#2a2a3c" Foreground="#00d2ff" Padding="10,4" CornerRadius="4" FontSize="12"/>
                    <Button Content="Switch to split line" Command="{Binding ToggleSplitEditModeCommand}"
                            IsVisible="{Binding IsQuadSplitMode}"
                            Background="#2a2a3c" Foreground="#00d2ff" Padding="10,4" CornerRadius="4" FontSize="12"/>
                </StackPanel>

                <!-- Book Split Slider (Visible only in line-split mode) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            IsVisible="{Binding IsLineSplitMode}" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Split Point:" Foreground="#a0a0b0" VerticalAlignment="Center"/>
                    <Slider Minimum="1" Maximum="99" Value="{Binding SplitPercent}" Width="200" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SplitPercent, StringFormat='{}{0:F0}%'}" Foreground="#00d2ff" FontWeight="Bold" Width="40" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Content="Reset" Command="{Binding ResetCommand}"
                            Background="#2a2a3c" Foreground="#e0e0e0" Padding="14,6" CornerRadius="4"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" 
                            CommandParameter="{Binding $parent[Window]}"
                            Background="#2a2a3c" Foreground="#e0e0e0" Padding="14,6" CornerRadius="4"/>
                    <Button Content="Save &amp; Reprocess" Command="{Binding SaveCommand}"
                            CommandParameter="{Binding $parent[Window]}"
                            Background="#e94560" Foreground="White" Padding="16,6" FontWeight="Bold" CornerRadius="4"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
