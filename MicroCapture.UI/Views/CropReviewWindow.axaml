<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MicroCapture.UI.ViewModels"
        xmlns:conv="using:MicroCapture.UI.Converters"
        xmlns:acv="using:Avalonia.Data.Converters"
        x:Class="MicroCapture.UI.Views.CropReviewWindow"
        x:DataType="vm:CropReviewViewModel"
        Background="{StaticResource CanvasBrush}">
    <Grid RowDefinitions="*, Auto">
        <Grid Grid.Row="0" ColumnDefinitions="2*, 1*">
            <!-- Main Image & Interactive Crop Canvas Area -->
            <Border Grid.Column="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1" Margin="14" CornerRadius="10" ClipToBounds="True">
                <Grid Name="ContainerGrid">
                    <Image Name="TargetImage"
                           Source="{Binding Image}"
                           IsVisible="{Binding !IsDewarpMode}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    <!-- Dewarp mode edits against the already-cropped (but not yet dewarped)
                         page, so the operator can see and trace the page's actual curved text
                         lines — the corrected result previews separately, in the LIVE PREVIEW
                         panel, so the surface being dragged against never moves under the
                         cursor while adjusting it. -->
                    <Image Name="DewarpBackdropTargetImage"
                           Source="{Binding DewarpBackdropImage}"
                           IsVisible="{Binding IsDewarpMode}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    <Canvas Name="OverlayCanvas"
                            Background="Transparent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>
                    <TextBlock Text="{Binding LoadErrorMessage}"
                               IsVisible="{Binding LoadErrorMessage, Converter={x:Static acv:StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource InkMutedBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               MaxWidth="360" FontSize="14"/>
                </Grid>
            </Border>

            <!-- Live Preview -->
            <Border Grid.Column="1" Classes="panel" Margin="0,14,14,14" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock Text="LIVE PREVIEW" Classes="sectionLabel" Foreground="{StaticResource PrimaryHoverBrush}"/>
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                           IsVisible="{Binding IsSinglePage}" MaxHeight="500"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsSplitBookPages}">
                        <StackPanel Spacing="5" Width="150">
                            <TextBlock Text="Left" Classes="caption"/>
                            <Border CornerRadius="6" ClipToBounds="True" Background="{StaticResource Surface2Brush}">
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="5" Width="150">
                            <TextBlock Text="Right" Classes="caption"/>
                            <Border CornerRadius="6" ClipToBounds="True" Background="{StaticResource Surface2Brush}">
                                <Image Source="{Binding SecondaryPreviewImage}" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Adjust mode: rotate/flip/tone/color/sharpen controls, grouped -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsAdjustMode}" Margin="0,8,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="PRESETS" Classes="sectionLabel" Foreground="{StaticResource InkSubtleBrush}"/>
                            <WrapPanel>
                                <Button Content="Document" Command="{Binding ApplyPresetDocumentCommand}" Classes="accentGhost" Margin="0,0,6,6"/>
                                <Button Content="Photo" Command="{Binding ApplyPresetPhotoCommand}" Classes="accentGhost" Margin="0,0,6,6"/>
                                <Button Content="Grayscale" Command="{Binding ApplyPresetGrayscaleCommand}" Classes="accentGhost" Margin="0,0,6,6"/>
                                <Button Content="B&amp;W" Command="{Binding ApplyPresetBlackAndWhiteCommand}" Classes="accentGhost" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="GEOMETRY" Classes="sectionLabel" Foreground="{StaticResource InkSubtleBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="↺ Rotate" Command="{Binding RotateCounterclockwiseCommand}" Classes="secondary" ToolTip.Tip="Rotate counterclockwise 90°"/>
                                <Button Content="↻ Rotate" Command="{Binding RotateClockwiseCommand}" Classes="secondary" ToolTip.Tip="Rotate clockwise 90°"/>
                                <TextBlock Text="{Binding RotationDegrees, StringFormat='{}{0}°'}" VerticalAlignment="Center" Foreground="{StaticResource InkMutedBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton Content="Flip H" IsChecked="{Binding FlipHorizontal}" Classes="secondary"/>
                                <ToggleButton Content="Flip V" IsChecked="{Binding FlipVertical}" Classes="secondary"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="LIGHT &amp; COLOR" Classes="sectionLabel" Foreground="{StaticResource InkSubtleBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Brightness" Classes="caption"/>
                                <Slider Minimum="-1" Maximum="1" Value="{Binding Brightness}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Contrast" Classes="caption"/>
                                <Slider Minimum="-1" Maximum="1" Value="{Binding Contrast}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Saturation" Classes="caption"/>
                                <Slider Minimum="-1" Maximum="1" Value="{Binding Saturation}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="White Balance" Classes="caption"/>
                                <Slider Minimum="-1" Maximum="1" Value="{Binding WhiteBalance}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="DETAIL" Classes="sectionLabel" Foreground="{StaticResource InkSubtleBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Sharpness" Classes="caption"/>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Sharpness}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="BATCH" Classes="sectionLabel" Foreground="{StaticResource InkSubtleBrush}"/>
                            <Button Content="Apply to All in Batch" Command="{Binding ApplyToAllCommand}" Classes="secondary" HorizontalAlignment="Stretch"/>
                            <Button Content="Apply to Selected" Command="{Binding ApplyToSelectionCommand}" Classes="secondary"
                                    HorizontalAlignment="Stretch" IsVisible="{Binding HasSelectionForBulkApply}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="1" Classes="panel" Margin="14,0,14,14" Padding="16,12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Mode & Instruction Text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="Split Book Pages" IsVisible="{Binding IsSplitBookPages}"
                               Foreground="{StaticResource PrimaryHoverBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Single Page Crop" IsVisible="{Binding IsSinglePage}"
                               Foreground="{StaticResource PrimaryHoverBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{Binding BoundaryHintText, Converter={x:Static conv:StatusSeverityConverter.Instance}}"/>
                        <TextBlock Text="{Binding BoundaryHintText}"
                                   Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>

                    <Button Content="Switch to page-by-page" Command="{Binding ToggleSplitEditModeCommand}"
                            IsVisible="{Binding IsLineSplitMode}" Classes="accentGhost"/>
                    <Button Content="Switch to split line" Command="{Binding ToggleSplitEditModeCommand}"
                            IsVisible="{Binding IsQuadSplitMode}" Classes="accentGhost"/>
                    <Button Content="{Binding DewarpEditButtonLabel}" Command="{Binding ToggleDewarpEditModeCommand}"
                            ToolTip.Tip="Manually trace this page's actual top/bottom curve when auto-detection isn't confident enough"
                            Classes="accentGhost"/>
                    <Button Content="{Binding AdjustEditButtonLabel}" Command="{Binding ToggleAdjustModeCommand}"
                            ToolTip.Tip="Rotate, flip, and adjust brightness/contrast/saturation/sharpness/white balance"
                            Classes="accentGhost"/>
                </StackPanel>

                <!-- Book Split Slider (Visible only in line-split mode) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            IsVisible="{Binding IsLineSplitMode}" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Split Point" Foreground="{StaticResource InkSubtleBrush}" FontSize="13" VerticalAlignment="Center"/>
                    <Slider Minimum="1" Maximum="99" Value="{Binding SplitPercent}" Width="200" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SplitPercent, StringFormat='{}{0:F0}%'}"
                               Foreground="{StaticResource PrimaryHoverBrush}" FontWeight="SemiBold" Width="40" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Content="Reset" Command="{Binding ResetCommand}" Classes="secondary"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="secondary"/>
                    <Button Content="Save &amp; Reprocess" Command="{Binding SaveCommand}" Classes="primary"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
