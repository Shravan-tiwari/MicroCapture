<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MicroCapture.UI.ViewModels"
        xmlns:conv="using:MicroCapture.UI.Converters"
        xmlns:acv="using:Avalonia.Data.Converters"
        x:Class="MicroCapture.UI.Views.CropReviewWindow"
        x:DataType="vm:CropReviewViewModel"
        Background="{DynamicResource CanvasBrush}">
    <Grid RowDefinitions="*, Auto">
        <Grid Grid.Row="0" ColumnDefinitions="2*, 1*">
            <!-- Main Image & Interactive Crop Canvas Area -->
            <Border Grid.Column="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="1" Margin="14" CornerRadius="10" ClipToBounds="True">
                <Grid Name="ContainerGrid">
                    <!-- Adjust mode judges rotation/tone/color against the actual page, shown
                         large — PreviewImage is the same live-adjusted render the small LIVE
                         PREVIEW panel already computes, at full size here so changes are
                         visible rather than judged from a thumbnail. This window only ever
                         offers Adjust mode now — manual crop-quad/split-line/dewarp-curve
                         editing has been removed.

                         The image sits in a ScrollViewer and is given an explicit pixel size by
                         the code-behind rather than being stretched to fit, because that is what
                         makes zoom mean something: at fit the size is the fitted size, and past
                         it the scroller pans over an image genuinely larger than the viewport.
                         Stretch is None for the same reason — the size is the zoom. -->
                    <ScrollViewer Name="PreviewScroller"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Name="ZoomHost" Background="Transparent">
                            <Image Name="AdjustTargetImage"
                                   Source="{Binding PreviewImage}"
                                   Stretch="None"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </ScrollViewer>

                    <TextBlock Text="{Binding LoadErrorMessage}"
                               IsVisible="{Binding LoadErrorMessage, Converter={x:Static acv:StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource InkMutedBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               MaxWidth="360" FontSize="14"/>

                    <!-- Loupe: the patch of page under the cursor, magnified, pinned near the
                         pointer. Focus is the thing this window is most often opened to judge,
                         and a whole page scaled into a panel is exactly the view in which soft
                         focus is invisible. Not hit-testable — it must never eat the wheel
                         events or drags it is floating over. -->
                    <Border Name="Loupe" Width="196" Height="196" CornerRadius="98"
                            IsVisible="False" IsHitTestVisible="False"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource Surface1Brush}"
                            BorderBrush="{DynamicResource PrimaryHoverBrush}" BorderThickness="2"
                            ClipToBounds="True">
                        <Image Name="LoupeImage" Stretch="Fill"/>
                    </Border>

                    <!-- Zoom controls, over the image rather than in the side panel: they act on
                         this view, not on the page's stored adjustments, and nothing here is
                         saved. -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14"
                            Background="{DynamicResource ScrimBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
                            Padding="6,4">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Name="ZoomOutButton" Classes="ghost" Content="−" FontSize="16" Padding="9,1"
                                    ToolTip.Tip="Zoom out"/>
                            <TextBlock Name="ZoomLabel" Text="Fit" VerticalAlignment="Center"
                                       MinWidth="42" TextAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource InkMutedBrush}"/>
                            <Button Name="ZoomInButton" Classes="ghost" Content="+" FontSize="16" Padding="9,1"
                                    ToolTip.Tip="Zoom in"/>
                            <Rectangle Width="1" Height="16" Margin="4,0" VerticalAlignment="Center"
                                       Fill="{DynamicResource HairlineStrongBrush}"/>
                            <Button Name="ZoomFitButton" Classes="ghost" Content="Fit" FontSize="12" Padding="7,3"
                                    ToolTip.Tip="Fit the whole page in the window"/>
                            <Button Name="ZoomActualButton" Classes="ghost" Content="100%" FontSize="12" Padding="7,3"
                                    ToolTip.Tip="Show the preview at its own pixel size"/>
                            <ToggleButton Name="LoupeToggle" Classes="secondary" Content="Loupe" FontSize="12"
                                          Padding="7,3" IsChecked="True"
                                          ToolTip.Tip="Magnify whatever is under the cursor"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Live Preview -->
            <Border Grid.Column="1" Classes="panel" Margin="0,14,14,14" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock Text="LIVE PREVIEW" Classes="sectionLabel" Foreground="{DynamicResource PrimaryHoverBrush}"/>
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxHeight="500"/>

                    <!-- Rotate/flip/tone/color/sharpen controls, grouped — this window only ever
                         offers Adjust mode now (manual crop-quad/split-line/dewarp-curve editing
                         removed; reprocessing re-detects the page boundary automatically). -->
                    <StackPanel Spacing="16" Margin="0,8,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="PRESETS" Classes="sectionLabel" Foreground="{DynamicResource InkSubtleBrush}"/>
                            <WrapPanel>
                                <Button Content="Document" Command="{Binding ApplyPresetDocumentCommand}" Classes="accentGhost" Margin="0,0,6,6"/>
                                <Button Content="Photo" Command="{Binding ApplyPresetPhotoCommand}" Classes="accentGhost" Margin="0,0,6,6"/>
                                <Button Content="Grayscale" Command="{Binding ApplyPresetGrayscaleCommand}" Classes="accentGhost" Margin="0,0,6,6"/>
                                <Button Content="B&amp;W" Command="{Binding ApplyPresetBlackAndWhiteCommand}" Classes="accentGhost" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="GEOMETRY" Classes="sectionLabel" Foreground="{DynamicResource InkSubtleBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="↺ Rotate" Command="{Binding RotateCounterclockwiseCommand}" Classes="secondary" ToolTip.Tip="Rotate counterclockwise 90°"/>
                                <Button Content="↻ Rotate" Command="{Binding RotateClockwiseCommand}" Classes="secondary" ToolTip.Tip="Rotate clockwise 90°"/>
                                <TextBlock Text="{Binding RotationDegrees, StringFormat='{}{0}°'}" VerticalAlignment="Center" Foreground="{DynamicResource InkMutedBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton Content="Flip H" IsChecked="{Binding FlipHorizontal}" Classes="secondary"/>
                                <ToggleButton Content="Flip V" IsChecked="{Binding FlipVertical}" Classes="secondary"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="LIGHT &amp; COLOR" Classes="sectionLabel" Foreground="{DynamicResource InkSubtleBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Brightness" Classes="caption"/>
                                <Slider Minimum="-1" Maximum="1" Value="{Binding Brightness}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Contrast" Classes="caption"/>
                                <Slider Minimum="-1" Maximum="1" Value="{Binding Contrast}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Saturation" Classes="caption"/>
                                <Slider Minimum="-1" Maximum="1" Value="{Binding Saturation}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="White Balance" Classes="caption"/>
                                <Slider Minimum="-1" Maximum="1" Value="{Binding WhiteBalance}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="DETAIL" Classes="sectionLabel" Foreground="{DynamicResource InkSubtleBrush}"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Sharpness" Classes="caption"/>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Sharpness}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Bulk-apply writes adjustment fields meant to be recomputed from each
                             target job's own original — meaningless once this job's own edit is
                             a delta-on-derivative rather than a from-scratch value, so it's
                             hidden entirely in that mode rather than silently doing the wrong
                             thing for every other page it would touch. -->
                        <StackPanel Spacing="8" IsVisible="{Binding !IsPostExportAdjustOnly}">
                            <TextBlock Text="BATCH" Classes="sectionLabel" Foreground="{DynamicResource InkSubtleBrush}"/>
                            <Button Content="Apply to All in Batch" Command="{Binding ApplyToAllCommand}" Classes="secondary" HorizontalAlignment="Stretch"/>
                            <Button Content="Apply to Selected Now" Command="{Binding ApplyToSelectionCommand}" Classes="secondary"
                                    HorizontalAlignment="Stretch" IsVisible="{Binding HasSelectionForBulkApply}"
                                    ToolTip.Tip="Apply to the other selected pages without closing. Saving applies to them too, so this is optional."/>
                            <TextBlock IsVisible="{Binding HasSelectionForBulkApply}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkTertiaryBrush}"
                                       Text="Saving applies these adjustments to every page you selected."/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="1" Classes="panel" Margin="14,0,14,14" Padding="16,12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Instruction Text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{Binding BoundaryHintText, Converter={x:Static conv:StatusSeverityConverter.Instance}}"/>
                        <TextBlock Text="{Binding BoundaryHintText}"
                                   Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Content="Reset" Command="{Binding ResetCommand}" Classes="secondary"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="secondary"/>
                    <Button Content="{Binding SaveButtonLabel}" Command="{Binding SaveCommand}" Classes="primary"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
