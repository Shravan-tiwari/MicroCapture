<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MicroCapture.UI.ViewModels"
        x:Class="MicroCapture.UI.Views.CropReviewWindow"
        x:DataType="vm:CropReviewViewModel"
        Title="Manual Crop Review"
        Width="1000" Height="700"
        Background="#1a1a2e">
    <Grid RowDefinitions="*, Auto">
        <!-- Image Area -->
        <Border Grid.Row="0" Background="#0a0a15" Margin="10">
            <Grid>
                <Image Source="{Binding Image}" Stretch="Uniform" />
                <TextBlock Text="Set a crop rectangle, or a split point for book pages, then save to reprocess."
                           Foreground="White" Background="#80000000" Padding="8"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"/>
            </Grid>
        </Border>

        <!-- Controls -->
        <Border Grid.Row="1" Margin="10" Background="#16213e" Padding="10" CornerRadius="6">
            <StackPanel Spacing="10">
                <StackPanel IsVisible="{Binding IsSplitBookPages}" Spacing="4">
                    <TextBlock Text="Book-page split (%)" Foreground="Cyan" />
                    <Slider Minimum="1" Maximum="99" Value="{Binding SplitPercent}" />
                </StackPanel>
                <Grid IsVisible="{Binding IsSinglePage}" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Foreground="Cyan" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Y" Foreground="Cyan" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Width" Foreground="Cyan" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Height" Foreground="Cyan" />
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding CropX}" Margin="0,4,4,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CropY}" Margin="4,4,4,0" />
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CropWidth}" Margin="4,4,4,0" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CropHeight}" Margin="4,4,0,0" />
                </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Cancel" Command="{Binding CancelCommand}" 
                        CommandParameter="{Binding $parent[Window]}"
                        Background="#333" Foreground="White" Padding="10,5" />
                <Button Content="Save &amp; Reprocess" Command="{Binding SaveCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        Background="#e94560" Foreground="White" Padding="10,5" FontWeight="Bold" />
            </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
