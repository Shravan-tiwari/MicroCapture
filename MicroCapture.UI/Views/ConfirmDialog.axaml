<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MicroCapture.UI.Views.ConfirmDialog"
        Title="Confirm"
        Icon="/Assets/microcapture-icon.png"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Border Classes="panel" Margin="18" Padding="20">
        <StackPanel Spacing="18">
            <TextBlock Name="MessageText" TextWrapping="Wrap" FontSize="14"
                       Foreground="{StaticResource InkMutedBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Name="CancelButton" Content="Cancel" Classes="secondary"/>
                <Button Name="ConfirmButton" Content="Confirm" Classes="primary"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
